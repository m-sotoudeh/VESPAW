${BINDIR}/vespaw_bands.x: ${OBJBANDS} ${PAWLIBFULL}
	${LINK} -o ${BINDIR}/vespaw_bands.x ${OBJBANDS} -L${OBJDIR}  -lpawfull ${LIBS}
#
${BINDIR}/vespaw_bands_mpi.x: ${OBJBANDS} ${PPAWLIBFULL}
	${LINK} -o ${BINDIR}/vespaw_bands_mpi.x ${OBJBANDS} -L${OBJDIR}  -lppawfull ${LIBS}
#
clean_bands:
	rm -f ${OBJBANDS}; rm -f ${BINDIR}/vespaw_bands.x
	rm -f ${OBJBANDS}; rm -f ${BINDIR}/vespaw_bands_mpi.x
