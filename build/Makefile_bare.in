clean_test:
	rm -f ${OBJTEST} ${BINDIR}/vespaw_test.x
#
${BINDIR}/vespaw_lattice.x: ${OBJLATTICE} ${PAWLIB} ${OBJDIR}/vespaw_setupread.o
	${LINK} -o ${BINDIR}/vespaw_lattice.x ${OBJLATTICE} ${OBJDIR}/vespaw_setupread.o -L${OBJDIR} -lpaw ${LIBS}
#
clean_lattice:
	rm -f ${OBJLATTICE} ${BINDIR}/vespaw_lattice.x
#
${BINDIR}/vespaw_newatom.x: ${OBJNEWATOM} ${PAWLIB} ${OBJDIR}/vespaw_setupread.o
	${LINK} -o ${BINDIR}/vespaw_newatom.x ${OBJNEWATOM} ${OBJDIR}/vespaw_setupread.o -L${OBJDIR} -lpaw ${LIBS}
#
clean_newatom:
	rm -f ${OBJNEWATOM} ${BINDIR}/vespaw_newatom.x
#
${BINDIR}/vespaw_atom.x: ${OBJATOM} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_atom.x ${OBJATOM} -lpaw ${LIBS}
#
clean_atom:
	rm -f ${OBJATOM}; rm -f ${BINDIR}/vespaw_atom.x
#
${BINDIR}/vespaw_tra.x: ${OBJTRA} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_tra.x ${OBJTRA} ${OBJDIR}/vespaw_forcefield.o ${OBJDIR}/vespaw_classical.o -L${OBJDIR} -lpaw ${LIBS}
#
clean_tra:
	rm -f ${OBJTRA}; rm -f ${BINDIR}/vespaw_tra.x
#
${BINDIR}/vespaw_wave.x: ${OBJWAVE} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_wave.x ${OBJWAVE} -L${OBJDIR} -lpaw ${LIBS}
