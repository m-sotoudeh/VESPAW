${BINDIR}/vespaw_preopt.x: ${OBJPRE} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_preopt.x ${OBJPRE}  ${OBJDIR}/vespaw_forcefield.o ${OBJDIR}/vespaw_classical.o -L${OBJDIR}  -lpaw ${LIBS}
#
clean_preopt:
	rm -f ${OBJPRE}; rm -f ${BINDIR}/vespaw_preopt.x
#
${BINDIR}/vespaw_converttra.x: ${OBJCONVERTTRA} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_converttra.x ${OBJCONVERTTRA} -L${OBJDIR}  -lpaw ${LIBS}
#
clean_converttra:
	rm -f ${OBJCONVERTTRA}; rm -f ${BINDIR}/vespaw_converttra.x
