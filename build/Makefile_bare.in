${BINDIR}/vespaw_1davpot.x: ${OBJ1DAVPOT} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_1davpot.x ${OBJ1DAVPOT} -L${OBJDIR} -lpaw ${LIBS}
#
clean_1davpot:
	rm -f ${OBJ1DAVPOT}; rm -f ${BINDIR}/vespaw_1davpot.x
#
${BINDIR}/vespaw_cmcwave.x: ${OBJCMCWAVE} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_cmcwave.x ${OBJCMCWAVE} -L${OBJDIR}  -lpaw ${LIBS}
#
clean_cmcwave:
	rm -f ${OBJCMCWAVE}; rm -f ${BINDIR}/vespaw_cmcwave.x
#
${BINDIR}/vespaw_grab.x: ${OBJGRAB} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_grab.x ${OBJGRAB} -L${OBJDIR}  -lpaw ${LIBS}
#
clean_grab:
	rm -f ${OBJGRAB}; rm -f ${BINDIR}/vespaw_grab.x
