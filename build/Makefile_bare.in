${BINDIR}/vespaw_cleantra.x: ${OBJCLEANTRA} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_cleantra.x ${OBJCLEANTRA} -L${OBJDIR}  -lpaw ${LIBS}
#
clean_cleantra:
	rm -f ${OBJCLEANTRA}; rm -f ${BINDIR}/vespaw_cleantra.x
#
${BINDIR}/vespaw_strc.x: ${OBJSTRC} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_strc.x ${OBJSTRC} -L${OBJDIR} -lpaw ${LIBS}
#
clean_strc:
	rm -f ${OBJSTRC}; rm -f ${BINDIR}/vespaw_strc.x
#
${BINDIR}/vespaw_toxyz.x: ${OBJTOXYZ} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_toxyz.x ${OBJTOXYZ} -L${OBJDIR} -lpaw ${LIBS}
#
clean_toxyz:
	rm -f ${OBJTOXYZ}; rm -f ${BINDIR}/vespaw_toxyz.x
#
${BINDIR}/vespaw_tostrc.x: ${OBJTOSTRC} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_tostrc.x ${OBJTOSTRC} -L${OBJDIR} -lpaw ${LIBS}
#
clean_tostrc:
	rm -f ${OBJTOSTRC}; rm -f ${BINDIR}/vespaw_tostrc.x
#
${BINDIR}/vespaw_polyhedra.x: ${OBJPOLYHEDRA} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_polyhedra.x ${OBJPOLYHEDRA} -L${OBJDIR} -lpaw ${LIBS}
#
clean_polyhedra:
	rm -f ${OBJPOLYHEDRA}; rm -f ${BINDIR}/vespaw_polyhedra.x
#
# copy include files if necessary (controlled by if-statements above)
#
${OBJDIR}/fftw_f77.i:
	${FFTWINCLUDE}
#
${OBJDIR}/mpif.h:
	${MPIINCLUDE}
#
#########################################################################
##  execute tests                                                      ##
#########################################################################
#
tests: ${PAWX} varOBJTYPE_tests
varOBJTYPE_tests: ${PAWX} 
	rm -rf ${BINDIR}/varOBJTYPE_tests;cp -r ${THISDIR}/tests ${BINDIR}/varOBJTYPE_tests;cd ${BINDIR}/varOBJTYPE_tests;${MAKE} all
#
#${OBJDIR}/mm_vespaw_f77.o
#########################################################################
##  compile code files independent of parameter                        ##
##  and place the objects in OBJDIR                                    ##
#########################################################################
.PHONY: ${OBJVERSION} ${SRCBLOB}
#
#__special rule for parallel interface because of preprocessor___________
${MPE} : ${OBJDIR}/%$(MODE).o: ${SRCDIR}/%.f90 ${OBJDIR}/mpif.h
	${F90PP} $< >${OBJDIR}/$*$(MODE)_d.${FEXT}
	${COMPILE} -o $@ ${OBJDIR}/$*$(MODE)_d.${FEXT}
#
# generate version information __________________________________________
$(OBJVERSION): ${OBJDIR}/%.o: ${SRCDIR}/%.f90 
	${F90PP} $< >${OBJDIR}/$*_d.${FEXT}
	bash ${SRCDIR}/buildtools/Version/getversion.sh ${OBJDIR}/$*_d.${FEXT}
	${COMPILE} -o $@ ${OBJDIR}/$*_d.${FEXT}
#
# generate source blob __________________________________________________
${SRCBLOB}:
	rm -f vespaw_srcblob vespaw_srcblob.o
	tar -czf vespaw_srcblob ${SRCDIR} ${THISDIR}/parms.in_use
ifeq ($(shell uname -s),Linux) 
	ld -r -b binary -o vespaw_srcblob.o vespaw_srcblob
endif
ifeq ($(shell uname -s),Darwin)
	touch vespaw_srcblob_dummy.f90
	${COMPILE} -o vespaw_srcblob_dummy.o vespaw_srcblob_dummy.f90
	ld -r -o vespaw_srcblob.o -sectcreate binary pawsrcblob_bin vespaw_srcblob vespaw_srcblob_dummy.o
endif
#
#__general rule for object files_________________________________________
$(OBJECTS) $(LOBJS): ${OBJDIR}/%.o: ${SRCDIR}/%.f90
	${F90PP} $< >${OBJDIR}/$*_d.${FEXT}
	${COMPILE} -o $@ ${OBJDIR}/$*_d.${FEXT}
#
#__vespaw_scantau.f90 needs -notemplates: f90pp_tmplts.x segfaults on it for__
#__an unidentified reason (no actual F90PP template syntax is used in it,_
#__so -notemplates is a legitimate workaround, not a skip of real work)___
#__-- see SCAN0r notes
${OBJDIR}/vespaw_scantau.o: ${SRCDIR}/vespaw_scantau.f90
	${F90PP} -notemplates $< >${OBJDIR}/vespaw_scantau_d.${FEXT}
	${COMPILE} -o $@ ${OBJDIR}/vespaw_scantau_d.${FEXT}
#
#__vespaw_scannsph.f90 needs -notemplates too, same reason as vespaw_scantau.f90_
${OBJDIR}/vespaw_scannsph.o: ${SRCDIR}/vespaw_scannsph.f90
	${F90PP} -notemplates $< >${OBJDIR}/vespaw_scannsph_d.${FEXT}
	${COMPILE} -o $@ ${OBJDIR}/vespaw_scannsph_d.${FEXT}
#__vespaw_scankinden.f90 needs -notemplates too, same reason as vespaw_scantau.f90_
${OBJDIR}/vespaw_scankinden.o: ${SRCDIR}/vespaw_scankinden.f90
	${F90PP} -notemplates $< >${OBJDIR}/vespaw_scankinden_d.${FEXT}
	${COMPILE} -o $@ ${OBJDIR}/vespaw_scankinden_d.${FEXT}
#__vespaw_edft.f90 needs -notemplates too, same reason as vespaw_scantau.f90 --_
#__confirmed 2026-09-06 to segfault f90pp_tmplts.x even at the file's state___
#__before that day's EDFT$HAUXSTEP_MVPEXACT addition, so this is not caused___
#__by any specific subroutine, just the file having grown past whatever_______
#__triggers the same unidentified template-expander issue as the three above_
${OBJDIR}/vespaw_edft.o: ${SRCDIR}/vespaw_edft.f90
	${F90PP} -notemplates $< >${OBJDIR}/vespaw_edft_d.${FEXT}
	${COMPILE} -o $@ ${OBJDIR}/vespaw_edft_d.${FEXT}
#
#__general rule for object files fortran 77______________________________
$(LOBJSF77): ${OBJDIR}/%.o: ${SRCDIR}/%.f
	cp $< ${OBJDIR}/$*_d.f
	$(COMPILE:-fimplicit-none=) -o $@ ${OBJDIR}/$*_d.f
	#${COMPILE} -o $@ ${OBJDIR}/$*_d.f
