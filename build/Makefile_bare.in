${BINDIR}/vespaw_dos.x: ${OBJDOS} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_dos.x ${OBJDOS} -L${OBJDIR}  -lpaw ${LIBS}
#
clean_dos:
	rm -f ${OBJDOS}; rm -f ${BINDIR}/vespaw_dos.x
#
${BINDIR}/vespaw_dosplot.x: ${OBJDOSPLOT} ${PAWLIB}
	${LINK} -o ${BINDIR}/vespaw_dosplot.x ${OBJDOSPLOT} -L${OBJDIR}  -lpaw ${LIBS}
